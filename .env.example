# The watcher. This is the setup that marks bills paid.
WALLETD_URL=http://127.0.0.1:18082
WALLETD_ACCOUNT_INDEX=0

# Your display name on the bill.
MERCHANT_NAME=Brass

# Stand-in only. One shared u1, and Brass cannot see shielded payments to it.
# Leave this empty once the watcher is running.
# MERCHANT_UA=

# Lock the desk before you share the site.
# MERCHANT_SECRET=
